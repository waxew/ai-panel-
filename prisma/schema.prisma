generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum BotStatus {
  PENDING
  ACTIVE
  INVALID
  DISABLED
}

enum ScheduledJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  displayName          String?
  role                 UserRole              @default(CUSTOMER)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  workspaces           WorkspaceMember[]
  instagramOAuthStates InstagramOAuthState[]
}

model Workspace {
  id                      String                       @id @default(cuid())
  name                    String
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  members                 WorkspaceMember[]
  telegramBots            TelegramBot[]
  discordBots             DiscordBot[]
  instagramAccounts       InstagramAccount[]
  instagramRules          InstagramAutomationRule[]
  instagramEvents         InstagramAutomationEvent[]
  instagramOAuthStates    InstagramOAuthState[]
  whatsappAccounts        WhatsAppAccount[]
  whatsappConversations   WhatsAppConversation[]
  whatsappMessages        WhatsAppMessage[]
  whatsappAutomationRules WhatsAppAutomationRule[]
  whatsappTemplates       WhatsAppTemplate[]
  scheduledJobs           ScheduledJob[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        UserRole  @default(CUSTOMER)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model TelegramBot {
  id              String           @id @default(cuid())
  workspaceId     String
  telegramBotId   String           @unique
  username        String?
  displayName     String?
  description     String?
  tokenCiphertext String
  status          BotStatus        @default(PENDING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  buttons         TelegramButton[]
}

model TelegramButton {
  id          String      @id @default(cuid())
  botId       String
  parentId    String?
  title       String
  actionType  String
  actionValue String?
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  bot         TelegramBot @relation(fields: [botId], references: [id], onDelete: Cascade)
}

model DiscordBot {
  id               String           @id @default(cuid())
  workspaceId      String
  applicationId    String           @unique
  botUserId        String           @unique
  username         String?
  displayName      String?
  description      String?
  publicKey        String
  tokenCiphertext  String
  status           BotStatus        @default(PENDING)
  defaultGuildId   String?
  defaultChannelId String?
  settings         Json             @default("{}")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  commands         DiscordCommand[]

  @@index([workspaceId])
}

model DiscordCommand {
  id                String     @id @default(cuid())
  botId             String
  name              String
  description       String     @default("")
  responseText      String     @default("")
  responseEphemeral Boolean    @default(false)
  isActive          Boolean    @default(true)
  executions        Int        @default(0)
  lastUsedAt        DateTime?
  sortOrder         Int        @default(0)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  bot               DiscordBot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, name])
  @@index([botId, sortOrder])
}

model InstagramAccount {
  id                    String                     @id @default(cuid())
  workspaceId           String
  username              String
  displayName           String?
  followersCount        BigInt                     @default(0)
  followingCount        BigInt                     @default(0)
  postsCount            BigInt                     @default(0)
  engagementRate        Decimal?
  metrics               Json                       @default("{}")
  status                BotStatus                  @default(PENDING)
  lastSyncedAt          DateTime?
  metaAccountId         String?                    @unique
  pageId                String?
  accessTokenCiphertext String?
  tokenExpiresAt        DateTime?
  tokenRefreshedAt      DateTime?
  permissions           Json                       @default("[]")
  webhookSubscribed     Boolean                    @default(false)
  connectionMeta        Json                       @default("{}")
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  workspace             Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automationRules       InstagramAutomationRule[]
  automationEvents      InstagramAutomationEvent[]
}

model InstagramOAuthState {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  stateHash   String    @unique
  redirectUri String
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, expiresAt])
  @@index([userId, expiresAt])
}

model InstagramAutomationRule {
  id                 String                     @id @default(cuid())
  workspaceId        String
  instagramAccountId String?
  name               String
  triggerType        String
  triggerConfig      Json                       @default("{}")
  actionType         String                     @default("SEND_DM")
  actionConfig       Json                       @default("{}")
  isActive           Boolean                    @default(false)
  executions         Int                        @default(0)
  lastTriggeredAt    DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  workspace          Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount   InstagramAccount?          @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  events             InstagramAutomationEvent[]

  @@index([workspaceId])
  @@index([instagramAccountId, isActive])
}

model InstagramAutomationEvent {
  id                 String                    @id @default(cuid())
  workspaceId        String
  instagramAccountId String?
  ruleId             String?
  eventType          String
  providerEventId    String?                   @unique
  sourceUserId       String?
  sourceUsername     String?
  sourceText         String?
  outcome            String                    @default("RECEIVED")
  metadata           Json                      @default("{}")
  createdAt          DateTime                  @default(now())
  workspace          Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount   InstagramAccount?         @relation(fields: [instagramAccountId], references: [id], onDelete: SetNull)
  rule               InstagramAutomationRule?  @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([instagramAccountId, createdAt])
  @@index([ruleId, createdAt])
}

model WhatsAppAccount {
  id                    String                    @id @default(cuid())
  workspaceId           String
  wabaId                 String
  phoneNumberId          String                    @unique
  displayPhoneNumber     String?
  verifiedName           String?
  accessTokenCiphertext  String
  tokenType              String                    @default("SYSTEM_USER")
  status                 BotStatus                 @default(PENDING)
  webhookSubscribed      Boolean                   @default(false)
  qualityRating          String?
  messagingLimit         String?
  lastSyncedAt           DateTime?
  connectionMeta         Json                      @default("{}")
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  workspace              Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations          WhatsAppConversation[]
  messages               WhatsAppMessage[]
  automationRules        WhatsAppAutomationRule[]
  templates              WhatsAppTemplate[]

  @@index([workspaceId])
  @@index([wabaId])
}

model WhatsAppConversation {
  id                              String           @id @default(cuid())
  workspaceId                     String
  whatsappAccountId               String
  waUserId                        String
  customerPhone                   String?
  customerName                    String?
  status                          String           @default("OPEN")
  lastMessageAt                   DateTime?
  customerServiceWindowExpiresAt  DateTime?
  unreadCount                     Int              @default(0)
  metadata                        Json             @default("{}")
  createdAt                       DateTime         @default(now())
  updatedAt                       DateTime         @updatedAt
  workspace                       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  whatsappAccount                 WhatsAppAccount  @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)
  messages                        WhatsAppMessage[]

  @@unique([whatsappAccountId, waUserId])
  @@index([workspaceId, lastMessageAt])
}

model WhatsAppMessage {
  id                  String               @id @default(cuid())
  workspaceId         String
  whatsappAccountId   String
  conversationId      String
  providerMessageId   String?              @unique
  direction           String
  messageType         String               @default("text")
  body                String?
  templateName        String?
  status              String               @default("RECEIVED")
  pricingCategory     String?
  isTemplate          Boolean              @default(false)
  providerTimestamp   DateTime?
  metadata            Json                 @default("{}")
  createdAt           DateTime             @default(now())
  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  whatsappAccount     WhatsAppAccount       @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)
  conversation        WhatsAppConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([workspaceId, createdAt])
}

model WhatsAppAutomationRule {
  id                  String            @id @default(cuid())
  workspaceId         String
  whatsappAccountId   String?
  name                String
  triggerType         String
  triggerConfig       Json              @default("{}")
  actionType          String            @default("SEND_MESSAGE")
  actionConfig        Json              @default("{}")
  isActive            Boolean           @default(false)
  executions          Int               @default(0)
  lastTriggeredAt     DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  workspace           Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  whatsappAccount     WhatsAppAccount?   @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([whatsappAccountId, isActive])
}

model WhatsAppTemplate {
  id                  String           @id @default(cuid())
  workspaceId         String
  whatsappAccountId   String
  metaTemplateId      String?
  name                String
  language            String
  category            String
  status              String
  components          Json             @default("[]")
  qualityScore        String?
  lastSyncedAt        DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  workspace           Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  whatsappAccount     WhatsAppAccount   @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)

  @@unique([whatsappAccountId, name, language])
  @@index([workspaceId])
}

model ScheduledJob {
  id          String             @id @default(cuid())
  workspaceId String
  platform    String
  jobType     String
  payload     Json
  runAt       DateTime
  status      ScheduledJobStatus @default(PENDING)
  attempts    Int                @default(0)
  lastError   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
}
