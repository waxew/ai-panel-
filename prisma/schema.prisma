// راهنما: این Model یک موجودیت اصلی دیتابیس و مجموعه فیلدهای آن را تعریف می‌کند.
model WorkspaceMember {
  // راهنما: این خط فیلد «id» را همراه نوع، اختیاری/اجباری بودن، مقدار پیش‌فرض یا Relation آن تعریف می‌کند.
  id          String    @id @default(cuid())
  // راهنما: این خط فیلد «workspaceId» را همراه نوع، اختیاری/اجباری بودن، مقدار پیش‌فرض یا Relation آن تعریف می‌کند.
  workspaceId String
  // راهنما: این خط فیلد «userId» را همراه نوع، اختیاری/اجباری بودن، مقدار پیش‌فرض یا Relation آن تعریف می‌کند.
  userId      String
  // راهنما: این خط فیلد «role» را همراه نوع، اختیاری/اجباری بودن، مقدار پیش‌فرض یا Relation آن تعریف می‌کند.
  role        UserRole  @default(CUSTOMER)
  // راهنما: این خط فیلد «workspace» را همراه نوع، اختیاری/اجباری بودن، مقدار پیش‌فرض یا Relation آن تعریف می‌کند.
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // راهنما: این خط فیلد «user» را همراه نوع، اختیاری/اجباری بودن، مقدار پیش‌فرض یا Relation آن تعریف می‌کند.
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // راهنما: این دستور سطح Model یک Index، Unique constraint یا نگاشت دیتابیس را تعریف می‌کند.
  @@unique([workspaceId, userId])
// راهنما: این آکولاد پایان بلوک فعلی Model/Enum/Generator/Datasource است.
}

