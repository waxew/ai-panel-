// راهنما: این Model یک موجودیت اصلی دیتابیس و مجموعه فیلدهای آن را تعریف می‌کند.
model User {
  // راهنما: این خط فیلد «id» را همراه نوع، اختیاری/اجباری بودن، مقدار پیش‌فرض یا Relation آن تعریف می‌کند.
  id                   String                @id @default(cuid())
  // راهنما: این خط فیلد «email» را همراه نوع، اختیاری/اجباری بودن، مقدار پیش‌فرض یا Relation آن تعریف می‌کند.
  email                String                @unique
  // راهنما: این خط فیلد «displayName» را همراه نوع، اختیاری/اجباری بودن، مقدار پیش‌فرض یا Relation آن تعریف می‌کند.
  displayName          String?
  // راهنما: این خط فیلد «role» را همراه نوع، اختیاری/اجباری بودن، مقدار پیش‌فرض یا Relation آن تعریف می‌کند.
  role                 UserRole              @default(CUSTOMER)
  // راهنما: این خط فیلد «createdAt» را همراه نوع، اختیاری/اجباری بودن، مقدار پیش‌فرض یا Relation آن تعریف می‌کند.
