  // راهنما: این خط فیلد «updatedAt» را همراه نوع، اختیاری/اجباری بودن، مقدار پیش‌فرض یا Relation آن تعریف می‌کند.
  updatedAt            DateTime              @updatedAt
  // راهنما: این خط فیلد «workspaces» را همراه نوع، اختیاری/اجباری بودن، مقدار پیش‌فرض یا Relation آن تعریف می‌کند.
  workspaces           WorkspaceMember[]
  // راهنما: این خط فیلد «instagramOAuthStates» را همراه نوع، اختیاری/اجباری بودن، مقدار پیش‌فرض یا Relation آن تعریف می‌کند.
  instagramOAuthStates InstagramOAuthState[]
// راهنما: این آکولاد پایان بلوک فعلی Model/Enum/Generator/Datasource است.
}

