// راهنما: این فایل ساختار دیتابیس Prisma را تعریف می‌کند و کامنت هر خط نقش دستور بعدی را توضیح می‌دهد.
// راهنما: این بلوک تنظیم می‌کند Prisma چه Client یا خروجی‌ای تولید کند.
generator client {
  // راهنما: این گزینه نوع Provider را مشخص می‌کند؛ برای مثال PostgreSQL یا Prisma Client.
  provider = "prisma-client"
  // راهنما: این خط فیلد «output» را همراه نوع، اختیاری/اجباری بودن، مقدار پیش‌فرض یا Relation آن تعریف می‌کند.
  output   = "../apps/api/src/generated/prisma"
// راهنما: این آکولاد پایان بلوک فعلی Model/Enum/Generator/Datasource است.
}

// راهنما: این بلوک منبع دیتابیس و Provider مورد استفاده Prisma را تعریف می‌کند.
datasource db {
  // راهنما: این گزینه نوع Provider را مشخص می‌کند؛ برای مثال PostgreSQL یا Prisma Client.
  provider = "postgresql"
// راهنما: این آکولاد پایان بلوک فعلی Model/Enum/Generator/Datasource است.
}

