{
  "name": "ai-panel",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @ai-panel/web dev",
    "dev:api": "pnpm --filter @ai-panel/api dev",
    "dev:worker": "pnpm --filter @ai-panel/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "build:cloudflare": "pnpm --filter @ai-panel/web build",
    "deploy:cloudflare": "pnpm build:cloudflare && pnpm --filter @ai-panel/cloudflare deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "dotenv": "latest",
    "prisma": "^7.0.0",
    "tsx": "latest",
    "typescript": "7.0.2"
  }
}
