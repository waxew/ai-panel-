# AI-PANEL-FA-INLINE-GUIDE
# راهنما: این فایل نمونه متغیرهای محیطی را تعریف می‌کند.
# راهنما: این متغیر محیطی با نام «NODE_ENV» تنظیم یا Secret موردنیاز برنامه را از محیط اجرا دریافت می‌کند؛ مقدار واقعی Secret نباید در Git Commit شود.
NODE_ENV=development
# راهنما: این متغیر محیطی با نام «API_PORT» تنظیم یا Secret موردنیاز برنامه را از محیط اجرا دریافت می‌کند؛ مقدار واقعی Secret نباید در Git Commit شود.
API_PORT=4000
# راهنما: این متغیر محیطی با نام «DATABASE_URL» تنظیم یا Secret موردنیاز برنامه را از محیط اجرا دریافت می‌کند؛ مقدار واقعی Secret نباید در Git Commit شود.
DATABASE_URL=postgresql://ai_panel:ai_panel@localhost:5432/ai_panel?schema=public
# راهنما: این متغیر محیطی با نام «REDIS_URL» تنظیم یا Secret موردنیاز برنامه را از محیط اجرا دریافت می‌کند؛ مقدار واقعی Secret نباید در Git Commit شود.
REDIS_URL=redis://localhost:6379
# راهنما: این متغیر محیطی با نام «APP_ENCRYPTION_KEY» تنظیم یا Secret موردنیاز برنامه را از محیط اجرا دریافت می‌کند؛ مقدار واقعی Secret نباید در Git Commit شود.
APP_ENCRYPTION_KEY=change-me-development-key-32-bytes-minimum
# راهنما: این متغیر محیطی با نام «DEFAULT_WORKSPACE_ID» تنظیم یا Secret موردنیاز برنامه را از محیط اجرا دریافت می‌کند؛ مقدار واقعی Secret نباید در Git Commit شود.
DEFAULT_WORKSPACE_ID=local-workspace
# راهنما: این متغیر محیطی با نام «WEB_ORIGIN» تنظیم یا Secret موردنیاز برنامه را از محیط اجرا دریافت می‌کند؛ مقدار واقعی Secret نباید در Git Commit شود.
WEB_ORIGIN=http://localhost:5173
# راهنما: این متغیر محیطی با نام «VITE_API_URL» تنظیم یا Secret موردنیاز برنامه را از محیط اجرا دریافت می‌کند؛ مقدار واقعی Secret نباید در Git Commit شود.
VITE_API_URL=http://localhost:4000
# راهنما: این متغیر محیطی با نام «VITE_DEFAULT_WORKSPACE_ID» تنظیم یا Secret موردنیاز برنامه را از محیط اجرا دریافت می‌کند؛ مقدار واقعی Secret نباید در Git Commit شود.
VITE_DEFAULT_WORKSPACE_ID=local-workspace
